{
  "expo": {
    "name": "YT Core",
    "slug": "ytcoremobile",
    "scheme": "ytcore",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.ytcore.mobile" },
    "android": {
      "package": "com.ytcore.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["POST_NOTIFICATIONS"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-location", {
        "locationAlwaysAndWhenInUsePermission": "Kurye olarak teslimat sırasında konumunuz müşterilere ve yönetime yansıtılır.",
        "locationWhenInUsePermission": "Teslimat takibi için konumunuz kullanılır.",
        "isAndroidBackgroundLocationEnabled": true,
        "isAndroidForegroundServiceEnabled": true
      }],
      ["expo-notifications", { "color": "#4f46e5" }],
      ["expo-build-properties", { "android": { "usesCleartextTraffic": false } }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
